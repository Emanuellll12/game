for(let i=0;i<pts.length-1;i++){const a=pts[i],c=pts[i+1];const dx=c.x-a.x,dz=c.z-a.z,len=Math.sqrt(dx*dx+dz*dz);if(len<.3)continue;const angle=Math.atan2(dx,dz);const midY=(a.y+c.y)/2;
const deck=new THREE.Mesh(new THREE.BoxGeometry(width,.8,len),bridgeMat);deck.position.set((a.x+c.x)/2,midY,(a.z+c.z)/2);deck.rotation.y=angle;scene.add(deck);
[-1,1].forEach(side=>{const nx2=-dz/len,nz2=dx/len;const rail=new THREE.Mesh(new THREE.BoxGeometry(.15,.9,len),railMat);rail.position.set((a.x+c.x)/2+nx2*side*width/2,midY+.85,(a.z+c.z)/2+nz2*side*width/2);rail.rotation.y=angle;scene.add(rail)});
const nP=Math.max(1,Math.floor(len/22));for(let k=0;k<=nP;k++){const t=k/nP;const pier=new THREE.Mesh(new THREE.CylinderGeometry(.6,.8,14,8),pierMat);pier.position.set(a.x+dx*t,a.y+(c.y-a.y)*t-7,a.z+dz*t);scene.add(pier)}}});

// ═══════════════════════════════════════════════════════════════
// 7. ROTATÓRIA
// ═══════════════════════════════════════════════════════════════
const ringMat=new THREE.MeshStandardMaterial({color:0x1c1c1f,roughness:.85,side:THREE.DoubleSide});
const islandMat2=new THREE.MeshStandardMaterial({color:0x1f3a24,roughness:.95});
