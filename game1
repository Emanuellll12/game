const yellowMat=new THREE.MeshBasicMaterial({color:0xf2c744});
const whiteMat=new THREE.MeshBasicMaterial({color:0xe8e8e8});
for(let i=0;i<S.length-1;i+=3){
  const a=S[i],b=S[Math.min(i+2,S.length-1)];
  if(ptInAnyX((a.x+b.x)/2,(a.z+b.z)/2))continue;
  const dx=b.x-a.x,dz=b.z-a.z,len=Math.sqrt(dx*dx+dz*dz);
  if(len<.5)continue;
  const angle=Math.atan2(dx,dz);
  const mid={x:(a.x+b.x)/2,y:(a.y+b.y)/2+.06,z:(a.z+b.z)/2};
  if(!a.oneway){if(i%6<3){const m=new THREE.Mesh(new THREE.BoxGeometry(.3,.02,len*.6),yellowMat);m.rotation.y=angle;m.position.set(mid.x,mid.y,mid.z);scene.add(m)}}
  else{const{w}=widthFor(a);const nnx=-dz/len,nnz=dx/len;[-1,1].forEach(side=>{const off=side*(w/2-.25);const m=new THREE.Mesh(new THREE.BoxGeometry(.22,.02,len),whiteMat);m.rotation.y=angle;m.position.set(mid.x+nnx*off,mid.y,mid.z+nnz*off);scene.add(m)})}
}

// ═══════════════════════════════════════════════════════════════
// 6. PONTES
