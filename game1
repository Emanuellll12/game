// 3. LARGURA
// ═══════════════════════════════════════════════════════════════
const LANE_WIDTH=3.5;
function widthFor(pt){if(pt.lanes){const n=parseInt(pt.lanes);if(!isNaN(n)&&n>0)return{w:n*LANE_WIDTH,n}}const f=(pt.ref||'').includes('135');return{w:(f?2:1)*LANE_WIDTH,n:f?2:1}}

// ═══════════════════════════════════════════════════════════════
// 4. TERRENO SRTM
// ═══════════════════════════════════════════════════════════════
const TANGENT_WINDOW=7,TRANSITION_DIST=30,SHOULDER_WIDTH=2.0,LAT_HALF_EXTENT=150,LAT_STEP=4,LON_STRIDE=3;
const ASPHALT_COL=[.14,.14,.16],BRIDGE_COL=[.38,.40,.44],SHOULDER_COL=[.32,.28,.20];
const latCenterIdx=TC.lateral_offsets.indexOf(0);
const latStep=TC.lateral_offsets[1]-TC.lateral_offsets[0];
function sampleSRTM(km,absLat){
  const stKm=TC.stations_km;let lo=0,hi=stKm.length-1;
  while(lo<hi-1){const mid=(lo+hi)>>1;if(stKm[mid]<=km)lo=mid;else hi=mid}
  const segLen=(stKm[hi]-stKm[lo])||1;const fs=Math.min(Math.max((km-stKm[lo])/segLen,0),1);
  const fIdx=latCenterIdx+Math.min(absLat,TC.lateral_offsets[TC.lateral_offsets.length-1])/latStep;
  const lj=Math.min(Math.max(Math.floor(fIdx),0),TC.lateral_offsets.length-2);const fl=fIdx-lj;
  const h00=TC.points[lo][lj][1],h01=TC.points[lo][lj+1][1],h10=TC.points[hi][lj][1],h11=TC.points[hi][lj+1][1];
  return(h00+(h01-h00)*fl)*(1-fs)+(h10+(h11-h10)*fl)*fs;
}
let elevMin=Infinity,elevMax=-Infinity;
for(let si=0;si<TC.stations_km.length;si++)for(let li=0;li<TC.lateral_offsets.length;li++){const y=TC.points[si][li][1];if(y<elevMin)elevMin=y;if(y>elevMax)elevMax=y}
function elevColor(h){const t=(h-elevMin)/(elevMax-elevMin||1);let r,g,b;if(t<.45){r=.20+t*.25;g=.42+t*.25;b=.16}else if(t<.75){const k=(t-.45)/.3;r=.34+k*.22;g=.50-k*.10;b=.20+k*.05}else{const k=(t-.75)/.25;r=.56+k*.20;g=.52+k*.20;b=.48+k*.22}return[r,g,b]}
function lerpCol(a,b,t){return[a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t,a[2]+(b[2]-a[2])*t]}
const roundCircles=(D.roundabouts||[]).map((r,ri)=>{const raw=r.points;if(raw.length<3||roundaboutFlatY[ri]==null)return null;const pts=(raw.length>1&&Math.abs(raw[0].x-raw[raw.length-1].x)<.01&&Math.abs(raw[0].z-raw[raw.length-1].z)<.01)?raw.slice(0,-1):raw;const cx=pts.reduce((s,p)=>s+p.x,0)/pts.length,cz=pts.reduce((s,p)=>s+p.z,0)/pts.length;let outerR=0;pts.forEach(p=>{const d=Math.hypot(p.x-cx,p.z-cz);if(d>outerR)outerR=d});return{cx,cz,outerR,flatY:roundaboutFlatY[ri]}}).filter(Boolean);

// ═══════════════════════════════════════════════════════════════
// terrainHeightAt — antes dos prefabs
// ═══════════════════════════════════════════════════════════════
function terrainHeightAt(px,pz){
  let bd=Infinity,bi=0;
  for(let i=0;i<S.length;i+=3){const dx=S[i].x-px,dz=S[i].z-pz,dd=dx*dx+dz*dz;if(dd<bd){bd=dd;bi=i}}
  const s=S[bi];
  const prev=S[Math.max(bi-TANGENT_WINDOW,0)],next=S[Math.min(bi+TANGENT_WINDOW,S.length-1)];
  const dx=next.x-prev.x,dz=next.z-prev.z;const l=Math.sqrt(dx*dx+dz*dz)||1;
  const L=Math.sqrt(bd);
  const roadHalf=widthFor(s).w/2;
  const hasParallel=s.oneway&&s.medW!=null;
  const natural=sampleSRTM(s.km,L);
  const dRoad=L-roadHalf;
  const dPar=hasParallel?Math.abs(L-s.medW)-LANE_WIDTH:Infinity;
  let dRound=Infinity,roundY=0;
  roundCircles.forEach(c=>{const dd=Math.hypot(px-c.cx,pz-c.cz)-c.outerR;if(dd<dRound){dRound=dd;roundY=c.flatY}});
  const dMin=Math.min(dRoad,dPar,dRound);
  const roadY=dMin===dRound?roundY:s.y;
  if(dMin<=SHOULDER_WIDTH)return roadY;
  const MARGIN=1.9;
  if(dMin<TRANSITION_DIST){const t=(dMin-SHOULDER_WIDTH)/(TRANSITION_DIST-SHOULDER_WIDTH);const sm=t*t*(3-2*t);return roadY*(1-sm)+(natural+MARGIN)*sm}
  return natural+MARGIN;
}

// ═══════════════════════════════════════════════════════════════
// ██████████████████████████████████████████████████████████████
// SISTEMA DE PREFABS DE CRUZAMENTO
//
// LÓGICA CENTRAL:
//  1. Para cada rua em D.crossing_streets, acha o ponto dela
//     mais próximo da BR → esse é o centro do cruzamento.
//  2. Calcula a direção da BR e da rua nesse ponto.
//  3. Constrói um polígono de cruzamento grande o suficiente
//     para cobrir toda a área onde as duas malhas se sobrepõem.
//     O polígono é uma "gravata borboleta" / losango alongado:
//     não é um quadrado — é um shape com 8 vértices que segue
//     os dois eixos das vias, com largura proporcional a cada via.
//  4. Corta buildFused() e as ruas transversais FORA desse
//     polígono: vértices dentro → cota do prefab, malha do
//     prefab fica no topo via polygonOffset.
//  5. SEM faixas de pedestres. SEM calçada. Só asfalto limpo.
// ██████████████████████████████████████████████████████████████
// ═══════════════════════════════════════════════════════════════

const MAT_CROSS=new THREE.MeshStandardMaterial({
  color:0x1e1e22,roughness:.82,metalness:.05,
  polygonOffset:true,polygonOffsetFactor:-6,polygonOffsetUnits:-6
});

// Registro: cada entrada tem os dados necessários para o teste
// ponto-dentro-polígono (convexo, 8 verts no plano XZ)
// { cx,cy,cz, poly2d:[{x,z},...], flatY }
const XREG=[];

// ── ponto dentro de polígono convexo 2-D (winding/cross product) ──
function insidePoly(px,pz,poly){
  const n=poly.length;
  let sign=0;
  for(let i=0;i<n;i++){
    const a=poly[i],b=poly[(i+1)%n];
    const cross=(b.x-a.x)*(pz-a.z)-(b.z-a.z)*(px-a.x);
    if(cross===0)continue;
    const s=cross>0?1:-1;
    if(sign===0)sign=s;
    else if(s!==sign)return false;
  }
  return true;
}

function ptInAnyX(px,pz){
  for(const r of XREG)if(insidePoly(px,pz,r.poly2d))return r;
  return null;
}

// ── Constrói o polígono de cruzamento ─────────────────────────────
// Dados dois eixos (BR e rua), com half-widths wA e wB,
// e um centro cx,cz, gera um polígono com 8 vértices que cobre
// toda a área de sobreposição das duas faixas de asfalto,
// com um padding generoso para não sobrar "sombra pintada".
//
// O shape é a UNIÃO convexa das duas faixas retangulares:
//   Faixa A: retângulo ao longo da BR   (largura wA*2, comprimento wB*2+pad)
//   Faixa B: retângulo ao longo da rua  (largura wB*2, comprimento wA*2+pad)
// A união convexa de dois retângulos centrados é um octógono.
function buildCrossPolygon(cx,cz,
  brDX,brDZ,   // direção unitária da BR
  stDX,stDZ,   // direção unitária da rua
  wBR,         // half-width da BR
  wST,         // half-width da rua
  extraPad     // padding extra além das larguras
){
  // Perpendiculares
  const brPX=-brDZ, brPZ=brDX;
  const stPX=-stDZ, stPZ=stDX;

  // Extend: quanto cada faixa se estende na direção longitudinal
  // Use a half-width da outra via + pad como extensão
  const extBR=wST+extraPad;  // BR se estende até cobrir a largura da rua
  const extST=wBR+extraPad;  // rua se estende até cobrir a largura da BR

  // 8 pontos: cantos das duas faixas intercalados
  // Faixa BR: 4 cantos
  const brC=[
    {x:cx+brDX*extBR+brPX*wBR, z:cz+brDZ*extBR+brPZ*wBR},
    {x:cx+brDX*extBR-brPX*wBR, z:cz+brDZ*extBR-brPZ*wBR},
    {x:cx-brDX*extBR-brPX*wBR, z:cz-brDZ*extBR-brPZ*wBR},
    {x:cx-brDX*extBR+brPX*wBR, z:cz-brDZ*extBR+brPZ*wBR},
  ];
  // Faixa rua: 4 cantos
  const stC=[
    {x:cx+stDX*extST+stPX*wST, z:cz+stDZ*extST+stPZ*wST},
    {x:cx+stDX*extST-stPX*wST, z:cz+stDZ*extST-stPZ*wST},
    {x:cx-stDX*extST-stPX*wST, z:cz-stDZ*extST-stPZ*wST},
    {x:cx-stDX*extST+stPX*wST, z:cz-stDZ*extST+stPZ*wST},
  ];

  // Hull convexo dos 8 pontos (Graham scan simplificado)
  const all=[...brC,...stC];
  return convexHull(all);
}

function convexHull(pts){
  // Andrew's monotone chain
  const p=[...pts].sort((a,b)=>a.x!==b.x?a.x-b.x:a.z-b.z);
  const cross=(O,A,B)=>(A.x-O.x)*(B.z-O.z)-(A.z-O.z)*(B.x-O.x);
  const lower=[],upper=[];
  for(const pt of p){while(lower.length>=2&&cross(lower[lower.length-2],lower[lower.length-1],pt)<=0)lower.pop();lower.push(pt)}
  for(let i=p.length-1;i>=0;i--){const pt=p[i];while(upper.length>=2&&cross(upper[upper.length-2],upper[upper.length-1],pt)<=0)upper.pop();upper.push(pt)}
  lower.pop();upper.pop();
  return [...lower,...upper];
}

// ── Triangula polígono convexo (fan a partir do centróide) ────────
function triangulatePoly(poly,y){
  const n=poly.length;
  const cx=poly.reduce((s,p)=>s+p.x,0)/n;
  const cz=poly.reduce((s,p)=>s+p.z,0)/n;
  const verts=[],idx=[];
  verts.push(cx,y,cz); // 0 = centróide
  for(let i=0;i<n;i++)verts.push(poly[i].x,y,poly[i].z);
  for(let i=0;i<n;i++)idx.push(0,1+i,1+(i+1)%n);
  return{verts,idx};
}

// ── Detecta cruzamentos e constrói prefabs ─────────────────────────
function buildAllCrossings(){
  (D.crossing_streets||[]).forEach(st=>{
    const rawPts=st.points;
    if(!rawPts||rawPts.length<2)return;
    if(st.highway==='footway')return; // ignora calçadas

    const hw=st.highway;
    const wST=( hw==='primary'||hw==='tertiary'?8:
                hw==='residential'?7:
                hw==='service'?5:
                hw==='track'?4:6 )/2;

    // Acha o ponto da rua mais próximo da BR
    let bestD=Infinity,bestPtIdx=0,bestSIdx=0;
    rawPts.forEach((p,pi)=>{
      for(let i=0;i<S.length;i+=4){
        const dd=(S[i].x-p[0])**2+(S[i].z-p[1])**2;
        if(dd<bestD){bestD=dd;bestPtIdx=pi;bestSIdx=i;}
      }
    });
    if(bestD>900)return; // rua não chega perto da BR (>30m)

    const sp=S[bestSIdx];
    const wBR=widthFor(sp).w/2;

    // Direção da BR nesse ponto
    const prevS=S[Math.max(bestSIdx-8,0)],nextS=S[Math.min(bestSIdx+8,S.length-1)];
    const brDX0=nextS.x-prevS.x,brDZ0=nextS.z-prevS.z;
    const brL=Math.hypot(brDX0,brDZ0)||1;
    const brDX=brDX0/brL,brDZ=brDZ0/brL;

    // Direção da rua no ponto de cruzamento
    const pi=bestPtIdx;
    const p0=rawPts[Math.max(pi-1,0)],p1=rawPts[Math.min(pi+1,rawPts.length-1)];
    const stDX0=p1[0]-p0[0],stDZ0=p1[1]-p0[1];
    const stL=Math.hypot(stDX0,stDZ0)||1;
    const stDX=stDX0/stL,stDZ=stDZ0/stL;

    // Centro do prefab = ponto da BR mais próximo
    const cx=sp.x,cz=sp.z,cy=sp.y;

    // Padding generoso: cobre a "sombra pintada" que aparecia antes
    // Usa 1.5× a largura da via menor como padding mínimo
    const extraPad=Math.max(wBR,wST)*1.5+4.0;

    const poly=buildCrossPolygon(cx,cz,brDX,brDZ,stDX,stDZ,wBR,wST,extraPad);

    // Registra
    XREG.push({cx,cy,cz,poly2d:poly,flatY:cy});

    // Malha de asfalto do prefab
    const{verts,idx}=triangulatePoly(poly,cy+0.07);
    const geo=new THREE.BufferGeometry();
    geo.setAttribute('position',new THREE.Float32BufferAttribute(verts,3));
    geo.setIndex(idx);
    geo.computeVertexNormals();
    const mesh=new THREE.Mesh(geo,MAT_CROSS);
    mesh.receiveShadow=true;
    scene.add(mesh);
  });
  console.log(`[CROSSINGS] ${XREG.length} prefabs de cruzamento gerados`);
}
buildAllCrossings();

// ═══════════════════════════════════════════════════════════════
// 4b. buildFused — vértices dentro do prefab usam cota do prefab
// ═══════════════════════════════════════════════════════════════
function buildFused(){
  const verts=[],colors=[],indices=[];
  const lateralArr=[];
  for(let d=-LAT_HALF_EXTENT;d<=LAT_HALF_EXTENT;d+=LAT_STEP)lateralArr.push(d);
  const nLat=lateralArr.length;
  const stations=[];
  for(let i=0;i<S.length;i+=LON_STRIDE)stations.push(i);
  const nSt=stations.length;
  for(let si=0;si<nSt;si++){
    const i=stations[si];const s=S[i];
    const prev=S[Math.max(i-TANGENT_WINDOW,0)],next=S[Math.min(i+TANGENT_WINDOW,S.length-1)];
    const dx=next.x-prev.x,dz=next.z-prev.z;const l=Math.sqrt(dx*dx+dz*dz)||1;
    const nx=-dz/l,nz=dx/l;
    const roadHalf=widthFor(s).w/2;
    const hasParallel=s.oneway&&s.medW!=null;
    const parCenter=hasParallel?-s.medW:null;const parHalf=LANE_WIDTH;
    for(let li=0;li<nLat;li++){
      const L=lateralArr[li];const px=s.x+nx*L,pz=s.z+nz*L;
      const natural=sampleSRTM(s.km,Math.abs(L));
      const dRoad=Math.abs(L)-roadHalf;
      const dPar=hasParallel?Math.abs(L-parCenter)-parHalf:Infinity;
      let dRound=Infinity,roundY=0;
      roundCircles.forEach(c=>{const dd=Math.hypot(px-c.cx,pz-c.cz)-c.outerR;if(dd<dRound){dRound=dd;roundY=c.flatY}});
      const dMin=Math.min(dRoad,dPar,dRound);
      const roadY=dMin===dRound?roundY:s.y;
      let y,col;
      if(dMin<=0){y=roadY;col=s.bridge?BRIDGE_COL:ASPHALT_COL}
      else if(dMin<=SHOULDER_WIDTH){y=roadY;col=lerpCol(ASPHALT_COL,SHOULDER_COL,dMin/SHOULDER_WIDTH)}
      else if(dMin<TRANSITION_DIST){const t=(dMin-SHOULDER_WIDTH)/(TRANSITION_DIST-SHOULDER_WIDTH);const sm=t*t*(3-2*t);y=roadY*(1-sm)+natural*sm;col=lerpCol(SHOULDER_COL,elevColor(natural),sm)}
      else{y=natural;col=elevColor(natural)}
      // override dentro do prefab
      const rec=ptInAnyX(px,pz);
      if(rec){y=rec.flatY+0.02;col=ASPHALT_COL;}
      verts.push(px,y,pz);colors.push(col[0],col[1],col[2]);
    }
  }
  for(let si=0;si<nSt-1;si++)for(let li=0;li<nLat-1;li++){const a=si*nLat+li,b=a+1,c=(si+1)*nLat+li,dd=c+1;indices.push(a,c,b,b,c,dd)}
  const geo=new THREE.BufferGeometry();
  geo.setAttribute('position',new THREE.Float32BufferAttribute(verts,3));
  geo.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));
  geo.setIndex(indices);geo.computeVertexNormals();
  return new THREE.Mesh(geo,new THREE.MeshStandardMaterial({vertexColors:true,roughness:.85,metalness:.05,side:THREE.DoubleSide}));
}
const terrain=buildFused();terrain.receiveShadow=true;scene.add(terrain);

