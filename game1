function medianFilter(v,hw){const o=[];for(let i=0;i<v.length;i++){const a=Math.max(0,i-hw),b=Math.min(v.length-1,i+hw);const w=v.slice(a,b+1).sort((x,y)=>x-y);o.push(w[Math.floor(w.length/2)])}return o}
