function stateAtDistance(distM){const d=Math.max(0,Math.min(distM,totalKmCurve*1000-.01));let lo=0,hi=S.length-1;while(lo<hi-1){const mid=(lo+hi)>>1;if(S[mid].km*1000<=d)lo=mid;else hi=mid}const a=S[lo],b=S[hi];const seg=(b.km-a.km)*1000;const t=seg>0?(d-a.km*1000)/seg:0;return{x:a.x+(b.x-a.x)*t,y:a.y+(b.y-a.y)*t,z:a.z+(b.z-a.z)*t,dirX:b.x-a.x,dirZ:b.z-a.z,lanes:a.lanes,oneway:a.oneway,surface:a.surface,ref:a.ref,bridge:a.bridge,km:a.km+(b.km-a.km)*t}}

