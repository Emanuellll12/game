const cab=new THREE.Mesh(new THREE.BoxGeometry(2.5,2.3,3.2),cm2);cab.position.set(0,1.5,3.6);cab.castShadow=true;
const ct=new THREE.Mesh(new THREE.BoxGeometry(2.3,1.1,1.6),cm2);ct.position.set(0,3.05,4.3);
const ws=new THREE.Mesh(new THREE.BoxGeometry(2.2,.9,.1),new THREE.MeshStandardMaterial({color:0x1c2b33,roughness:.1,metalness:.7}));ws.position.set(0,3,5.05);
const ch=new THREE.Mesh(new THREE.BoxGeometry(2.4,.5,8.5),new THREE.MeshStandardMaterial({color:0x2a2a2a}));ch.position.set(0,.85,-.5);
const tr=new THREE.Mesh(new THREE.BoxGeometry(2.55,2.7,7.6),new THREE.MeshStandardMaterial({color:0xe8e6df,roughness:.55,metalness:.2}));tr.position.set(0,2.05,-4.3);tr.castShadow=true;
truck.add(cab,ct,ws,ch,tr);
const wm=new THREE.MeshStandardMaterial({color:0x1a1a1a,roughness:.9});
[[-1.25,4.4],[1.25,4.4],[-1.25,1.3],[1.25,1.3],[-1.25,-3],[1.25,-3],[-1.25,-6.6],[1.25,-6.6]].forEach(([xx,zz])=>{const wh=new THREE.Mesh(new THREE.CylinderGeometry(.55,.55,.5,12),wm);wh.rotation.z=Math.PI/2;wh.position.set(xx,.55,zz);wh.castShadow=true;truck.add(wh)})}
scene.add(truck);
const SPAWN_KM=3;
{const st0=stateAtDistance(SPAWN_KM*1000);const h0=Math.atan2(st0.dirX,st0.dirZ);truck.position.set(st0.x,st0.y+.1,st0.z);truck.rotation.y=h0;camera.position.set(st0.x-Math.sin(h0)*16,st0.y+6,st0.z-Math.cos(h0)*16);camera.lookAt(st0.x,st0.y+2,st0.z)}

// ═══════════════════════════════════════════════════════════════
// 12. CONTROLES
// ═══════════════════════════════════════════════════════════════
const keys={};addEventListener('keydown',e=>{keys[e.key.toLowerCase()]=true});addEventListener('keyup',e=>{keys[e.key.toLowerCase()]=false});
let camMode=0;addEventListener('keydown',e=>{if(e.key.toLowerCase()==='c')camMode=(camMode+1)%4});
let orbitAz=.7,orbitEl=.5,orbitR=60,orbiting=false,lmx=0,lmy=0;
renderer.domElement.addEventListener('mousedown',e=>{if(camMode===3){orbiting=true;lmx=e.clientX;lmy=e.clientY}});
addEventListener('mouseup',()=>{orbiting=false});
addEventListener('mousemove',e=>{if(!orbiting||camMode!==3)return;orbitAz-=(e.clientX-lmx)*.007;orbitEl=Math.max(.05,Math.min(1.5,orbitEl-(e.clientY-lmy)*.007));lmx=e.clientX;lmy=e.clientY});
renderer.domElement.addEventListener('wheel',e=>{if(camMode!==3)return;orbitR=Math.max(8,Math.min(300,orbitR+e.deltaY*.06));e.preventDefault()},{passive:false});
const isTouchDevice=('ontouchstart' in window)||navigator.maxTouchPoints>0;
if(isTouchDevice)document.getElementById('touchControls').classList.add('active');
function bindHold(id,keyName){
  const el=document.getElementById(id);
  const down=e=>{e.preventDefault();keys[keyName]=true;el.classList.add('pressed')};
  const up=e=>{if(e)e.preventDefault();keys[keyName]=false;el.classList.remove('pressed')};
  el.addEventListener('touchstart',down,{passive:false});el.addEventListener('touchend',up,{passive:false});el.addEventListener('touchcancel',up,{passive:false});
  el.addEventListener('mousedown',down);el.addEventListener('mouseup',up);el.addEventListener('mouseleave',up);
}
bindHold('btnForward','w');bindHold('btnBackward','s');bindHold('btnLeft','a');bindHold('btnRight','d');
document.getElementById('btnCamera').addEventListener('touchstart',e=>{e.preventDefault();camMode=(camMode+1)%4},{passive:false});
document.getElementById('btnCamera').addEventListener('click',()=>{camMode=(camMode+1)%4});
let touchOrbiting=false,tlx=0,tly=0,pinchDist=0;
function touchDist(t0,t1){return Math.hypot(t1.clientX-t0.clientX,t1.clientY-t0.clientY)}
renderer.domElement.addEventListener('touchstart',e=>{if(camMode!==3)return;if(e.touches.length===1){touchOrbiting=true;tlx=e.touches[0].clientX;tly=e.touches[0].clientY}else if(e.touches.length===2){touchOrbiting=false;pinchDist=touchDist(e.touches[0],e.touches[1])}},{passive:true});
renderer.domElement.addEventListener('touchmove',e=>{if(camMode!==3)return;if(e.touches.length===1&&touchOrbiting){const dx=e.touches[0].clientX-tlx,dy=e.touches[0].clientY-tly;orbitAz-=dx*0.007;orbitEl=Math.max(0.05,Math.min(1.5,orbitEl-dy*0.007));tlx=e.touches[0].clientX;tly=e.touches[0].clientY;e.preventDefault()}else if(e.touches.length===2){const d=touchDist(e.touches[0],e.touches[1]);orbitR=Math.max(8,Math.min(300,orbitR-(d-pinchDist)*0.15));pinchDist=d;e.preventDefault()}},{passive:false});
renderer.domElement.addEventListener('touchend',e=>{if(e.touches.length<1)touchOrbiting=false},{passive:true});

// ═══════════════════════════════════════════════════════════════
// 13. LOOP
// ═══════════════════════════════════════════════════════════════
let distM=SPAWN_KM*1000,speed=0,laneOffset=0;
const MAX_SPEED=34;let vegUpdateTimer=0;
function update(dt){
  if(keys['w']||keys['arrowup'])speed+=12*dt;else if(keys['s']||keys['arrowdown'])speed-=16*dt;else speed-=Math.sign(speed)*4*dt;
  speed=Math.max(-MAX_SPEED*.4,Math.min(MAX_SPEED,speed));if(Math.abs(speed)<.05)speed=0;
  distM+=speed*dt;distM=Math.max(0,Math.min(distM,totalKmCurve*1000-1));
  const st=stateAtDistance(distM);const len3=Math.hypot(st.dirX,st.dirZ)||1;const nx3=-st.dirZ/len3,nz3=st.dirX/len3;
  const{w}=widthFor(st);const maxOff=Math.max(w/2-1.5,0);
  if(keys['a']||keys['arrowleft'])laneOffset-=4*dt;if(keys['d']||keys['arrowright'])laneOffset+=4*dt;
  laneOffset=Math.max(-maxOff,Math.min(maxOff,laneOffset));
  const heading=Math.atan2(st.dirX,st.dirZ);
  truck.position.set(st.x+nx3*laneOffset,st.y+.1,st.z+nz3*laneOffset);truck.rotation.y=heading;
  vegUpdateTimer+=dt;
  if(vegUpdateTimer>.3){vegUpdateTimer=0;updateVegetation(truck.position.x,truck.position.z);}
  const tp=truck.position.clone(),look=tp.clone().add(new THREE.Vector3(0,2,0));
  if(camMode===0){camera.position.lerp(tp.clone().add(new THREE.Vector3(-Math.sin(heading)*18,7,-Math.cos(heading)*18)),.045);camera.lookAt(look)}
  else if(camMode===1){camera.position.lerp(tp.clone().add(new THREE.Vector3(-Math.sin(heading)*7,3,-Math.cos(heading)*7)),.07);camera.lookAt(look)}
  else if(camMode===2){camera.position.lerp(tp.clone().add(new THREE.Vector3(0,80,0)),.04);camera.lookAt(tp)}
  else{camera.position.set(tp.x+Math.sin(orbitAz)*Math.cos(orbitEl)*orbitR,tp.y+2+Math.sin(orbitEl)*orbitR,tp.z+Math.cos(orbitAz)*Math.cos(orbitEl)*orbitR);camera.lookAt(tp.x,tp.y+2,tp.z)}
  sun.position.set(tp.x+300,tp.y+500,tp.z+150);sun.target.position.copy(tp);sun.target.updateMatrixWorld();
  document.getElementById('speed').textContent=Math.abs(Math.round(speed*3.6));
  document.getElementById('progressfill').style.width=((distM/(totalKmCurve*1000))*100)+'%';
  document.getElementById('datapanel').innerHTML=`<b>KM:</b> ${st.km.toFixed(1)} / ${totalKmCurve.toFixed(1)}<br><b>Elevação:</b> ${Math.round(st.y)}m<br><b>Faixas:</b> ${st.lanes||'?'}<br><b>Mão:</b> ${st.oneway?'única':'dupla'}<br><b>Superfície:</b> ${st.surface||'?'}<br>${st.bridge?'<span class="flag flag-bridge">PONTE</span><br>':''}<b>Ref:</b> ${st.ref||'—'}`;
  document.getElementById('orbithint').style.display=camMode===3?'block':'none';
  document.getElementById('touchOrbitHint').style.display=(camMode===3&&isTouchDevice)?'block':'none';
}
document.getElementById('loading').style.display='none';
document.getElementById('hud').style.display='';
updateVegetation(truck.position.x,truck.position.z);
let lastT=performance.now();
function animate(){requestAnimationFrame(animate);const now=performance.now();const dt=Math.min((now-lastT)/1000,.1);lastT=now;update(dt);renderer.render(scene,camera)}
animate();
</script>
