// ═══════════════════════════════════════════════════════════════
const streetExclusionPts=[];
const streetLineMat=new THREE.MeshBasicMaterial({color:0xf2e8c8});

(D.crossing_streets||[]).forEach(st=>{
  const rawPts=st.points;if(rawPts.length<2)return;
  const isAvenue=(st.highway==='primary'||st.highway==='tertiary'||st.highway==='primary_link');
  const width=Math.max(
    st.highway==='residential'?7:st.highway==='tertiary'?8:
    st.highway==='service'?5:st.highway==='track'?4:
    st.highway==='footway'?2.5:7, 7);

  let crossPtIdx=0,crossStationIdx=0,bestD=Infinity;
  rawPts.forEach((p,pi)=>{
    for(let i=0;i<S.length;i+=5){
      const dx=S[i].x-p[0],dz=S[i].z-p[1],dd=dx*dx+dz*dz;
      if(dd<bestD){bestD=dd;crossPtIdx=pi;crossStationIdx=i;}
    }
  });
  const anchorY=S[crossStationIdx].y;
  const anchorX=rawPts[crossPtIdx][0],anchorZ=rawPts[crossPtIdx][1];
  const CROSS_TRANSITION=25;

  const anchors3=rawPts.map((p,pi)=>{
    let y;
    if(pi===crossPtIdx)y=anchorY;
    else{
      const dCross=Math.hypot(p[0]-anchorX,p[1]-anchorZ);
      const natural=terrainHeightAt(p[0],p[1]);
      if(dCross<CROSS_TRANSITION){const t=dCross/CROSS_TRANSITION,sm=t*t*(3-2*t);y=anchorY*(1-sm)+natural*sm;}
      else y=natural;
    }
    return new THREE.Vector3(p[0],y,p[1]);
  });

  let curvePts=anchors3;
  if(anchors3.length>=3)curvePts=chaikin(anchors3,3);
  let sampled;
  if(curvePts.length>=3){
    const curve=new THREE.CatmullRomCurve3(curvePts,false,'centripetal');
    const n=Math.max(2,Math.round(curve.getLength()/3));
    sampled=curve.getSpacedPoints(n);
  }else sampled=curvePts;

  // Segmenta removendo pontos dentro de prefabs
  const segments=[];let cur=[];
  sampled.forEach(pt=>{
    if(ptInAnyX(pt.x,pt.z)){if(cur.length>=2)segments.push([...cur]);cur=[];}
    else cur.push(pt);
  });
  if(cur.length>=2)segments.push(cur);

  segments.forEach(seg=>{
    if(seg.length<2)return;
    for(let i=0;i<seg.length;i+=3)streetExclusionPts.push({x:seg[i].x,z:seg[i].z,half:width/2});

    const verts=[],colors2=[],idxA=[];
    const STREET_HALF_EXTENT=Math.max(width/2+22,30);
    const STREET_LAT_STEP=4,STREET_SHOULDER=0.6,STREET_TRANS=15;
    const lateralArr2=[];
    for(let d=-STREET_HALF_EXTENT;d<=STREET_HALF_EXTENT;d+=STREET_LAT_STEP)lateralArr2.push(d);
    const nLat2=lateralArr2.length;
    const FLARE_DIST=22;

    for(let si2=0;si2<seg.length;si2++){
      const p=seg[si2];
      const prev2=seg[Math.max(si2-3,0)],next2=seg[Math.min(si2+3,seg.length-1)];
      const dx=next2.x-prev2.x,dz=next2.z-prev2.z;
      const l=Math.sqrt(dx*dx+dz*dz)||1;
      const nx=-dz/l,nz=dx/l;
      const dCrossHere=Math.hypot(p.x-anchorX,p.z-anchorZ);
      const flare=dCrossHere<FLARE_DIST?(FLARE_DIST-dCrossHere)*1.8:0;
      const halfHere=width/2+flare;

      for(let li=0;li<nLat2;li++){
        const L=lateralArr2[li];
        const px2=p.x+nx*L,pz2=p.z+nz*L;
        const rec=ptInAnyX(px2,pz2);
        if(rec){verts.push(px2,rec.flatY+0.02,pz2);colors2.push(...ASPHALT_COL);continue;}
        const natural=terrainHeightAt(px2,pz2);
        const dStreet=Math.abs(L)-halfHere;
        let y,col;
        if(dStreet<=0){y=p.y;col=ASPHALT_COL;}
        else if(dStreet<=STREET_SHOULDER){y=p.y;col=lerpCol(ASPHALT_COL,SHOULDER_COL,dStreet/STREET_SHOULDER);}
        else if(dStreet<STREET_TRANS){const t2=(dStreet-STREET_SHOULDER)/(STREET_TRANS-STREET_SHOULDER);const sm=t2*t2*(3-2*t2);y=p.y*(1-sm)+natural*sm;col=lerpCol(SHOULDER_COL,elevColor(natural),sm);}
        else{y=natural;col=elevColor(natural);}
        verts.push(px2,y,pz2);colors2.push(col[0],col[1],col[2]);
      }
    }
    for(let si2=0;si2<seg.length-1;si2++)for(let li=0;li<nLat2-1;li++){const a=si2*nLat2+li,b=a+1,c=(si2+1)*nLat2+li,d2=c+1;idxA.push(a,c,b,b,c,d2);}
    if(verts.length===0)return;
    const geo=new THREE.BufferGeometry();
    geo.setAttribute('position',new THREE.Float32BufferAttribute(verts,3));
    geo.setAttribute('color',new THREE.Float32BufferAttribute(colors2,3));
    geo.setIndex(idxA);geo.computeVertexNormals();
    const mesh=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({vertexColors:true,roughness:.85,metalness:.05,side:THREE.DoubleSide}));
    mesh.receiveShadow=true;scene.add(mesh);
    if(isAvenue){
      for(let i=0;i<seg.length-1;i+=2){
        const a=seg[i],c2=seg[Math.min(i+1,seg.length-1)];
        const dx2=c2.x-a.x,dz2=c2.z-a.z,len2=Math.sqrt(dx2*dx2+dz2*dz2);
        if(len2<.3)continue;
        const ang2=Math.atan2(dx2,dz2);
        const line=new THREE.Mesh(new THREE.BoxGeometry(.35,.03,len2),streetLineMat);
        line.rotation.y=ang2;
        line.position.set((a.x+c2.x)/2,(a.y+c2.y)/2+.05,(a.z+c2.z)/2);
        scene.add(line);
      }
    }
  });
});

