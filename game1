const bridgeMat=new THREE.MeshStandardMaterial({color:0x6b6e75,roughness:.6,metalness:.35});
const railMat=new THREE.MeshStandardMaterial({color:0xd8442c,roughness:.5,metalness:.4});
const pierMat=new THREE.MeshStandardMaterial({color:0x4a4a4c,roughness:.9});
